# =============================================================================
# DrChat Evaluation Environment Configuration
# =============================================================================

# Base URL for the file service
FILE_SERVICE_BASE_URL="http://localhost:8001"

# Registration service URL
REGISTER_URL="http://localhost:8004/api/register"

# Session service URL
SESSION_URL="http://localhost:8003/session"

# Answer question service URL
ANSWER_QUESTION="http://localhost:8002/answer_question"

# Neo4j database configuration
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME=
NEO4J_PASSWORD=

# OpenAI API configuration
OPENAI_API_KEY=
OPENAI_API_BASE="https://api.groq.com/openai/v1"

# Large language model to use
LLM_CHAT_MODEL="meta-llama/llama-4-scout-17b-16e-instruct"
