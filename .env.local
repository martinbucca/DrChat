# Configuración para bases de datos LOCALES (containers)
# Database Connections
MONGODB_URL=mongodb://mongodb:27017/drchat
MONGODB_DATABASE_NAME=drchat

# Neo4j Configuration (local container)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Kafka Configuration (local container)
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_FILE_UPLOAD_TOPIC=file-upload-events
KAFKA_GROUP_ID=document-processor-group

# Service URLs (internal network)
FILE_SERVICE_URL=http://file-service:8000
